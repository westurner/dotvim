    import argparse

    prs = argparse.ArgumentParser(
        usage="%(prog)s [-h][-v] : ${6:args}")

    prs.add_argument(
        '-v', '--verbose',
        dest='verbose',
        action='store_true',)
    prs.add_argument(
        '-q', '--quiet',
        dest='quiet',
        action='store_true',)
    prs.add_argument(
        '-t', '--test',
        dest='run_tests',
        action='store_true',)
    prs.add_argument(
        '--version',
